{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "profileweaver/harness-plan.schema.json",
  "title": "ProfileWeaver resumable harness plan",
  "type": "object",
  "required": ["version", "run_id", "run_dir", "stages"],
  "properties": {
    "version": {"const": 1},
    "run_id": {"type": "string"},
    "run_dir": {"type": "string"},
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "fingerprint_env": {"type": "array", "items": {"type": "string"}},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "argv"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "cwd": {"type": "string"},
          "env": {"type": "object", "additionalProperties": {"type": "string"}},
          "fingerprint_env": {"type": "array", "items": {"type": "string"}},
          "requires": {"type": "array", "items": {"type": "string"}},
          "fingerprint_inputs": {"type": "array", "items": {"type": "string"}},
          "produces": {"type": "array", "items": {"type": "string"}},
          "timeout_s": {"type": ["number", "null"], "minimum": 0},
          "cache": {"type": "boolean"},
          "allow_failure": {"type": "boolean"}
        }
      }
    }
  }
}
