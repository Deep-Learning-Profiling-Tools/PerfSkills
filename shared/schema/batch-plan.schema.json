{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "profileweaver/batch-plan.schema.json",
  "title": "ProfileWeaver candidate batch",
  "type": "object",
  "required": ["version", "run_id", "run_dir", "plans"],
  "properties": {
    "version": {"const": 1},
    "run_id": {"type": "string"},
    "run_dir": {"type": "string"},
    "brief_phase": {"enum": ["optimize", "iterate", "repair", "final"]},
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["id", "plan"],
            "properties": {
              "id": {"type": "string"},
              "plan": {"type": "string"},
              "allow_failure": {"type": "boolean"}
            }
          }
        ]
      }
    }
  }
}
