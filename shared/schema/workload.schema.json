{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "profileweaver/workload.schema.json",
  "title": "ProfileWeaver workload manifest",
  "type": "object",
  "required": ["version", "name", "fingerprint_globs", "execution", "metric"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "question": {"type": "string"},
    "source": {"type": "string"},
    "selection_objective": {
      "type": "object",
      "required": ["scope"],
      "properties": {
        "scope": {"enum": ["application", "kernel"]},
        "kernel_regex": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "comparison_provider": {"type": "string", "minLength": 1},
        "collateral": {"enum": ["unprofiled", "profiled"]}
      },
      "allOf": [{"if": {"properties": {"scope": {"const": "kernel"}}},
                 "then": {"required": ["kernel_regex"]}}],
      "additionalProperties": false
    },
    "fingerprint_globs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_symbols": {"type": "array", "items": {"type": "string"}},
    "copy_ignore": {"type": "array", "items": {"type": "string"}},
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "execution": {
      "type": "object", "required": ["build", "command"],
      "properties": {
        "build": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "build_cwd": {"type": "string"},
        "build_timeout_s": {"type": "number", "minimum": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"type": "string"}, "timeout_s": {"type": "number", "minimum": 1},
        "env": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "metric": {"type": "object"}, "oracle": {"type": ["object", "null"]},
    "kernel_timing": {
      "type": ["object", "null"],
      "properties": {
        "source": {"enum": ["cuda-event", "nvtx", "ncu-duration", "stdout", "wall"]},
        "detail": {"type": ["string", "null"]}
      },
      "required": ["source"]
    },
    "sampling": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["standard", "winner-confirmation", "adaptive"]},
        "benchmark_max_runs": {"type": "integer", "minimum": 1, "maximum": 2},
        "screen_warmup": {"type": "integer", "minimum": 0},
        "screen_min_pairs": {"type": "integer", "minimum": 1},
        "screen_max_pairs": {"type": "integer", "minimum": 1},
        "metric_resolution": {"type": "number", "minimum": 0},
        "screen_margin": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
        "warmup": {"type": "integer", "minimum": 0},
        "min_pairs": {"type": "integer", "minimum": 5},
        "max_pairs": {"type": "integer", "minimum": 5},
        "final_min_pairs": {"type": "integer", "minimum": 5},
        "final_max_pairs": {"type": "integer", "minimum": 5},
        "finalists": {"type": "integer", "minimum": 1},
        "adaptive_finalists": {"type": "integer", "minimum": 1, "maximum": 2},
        "bootstrap_iterations": {"type": "integer", "minimum": 200},
        "practical_threshold": {"type": "number", "exclusiveMinimum": 1.0},
        "wall_gate": {"enum": ["advisory", "strict", "off"]}
      }
    },
    "profiling": {"type": "object", "properties": {
      "cadence": {"enum": ["baseline-final", "every-candidate"]},
      "roi_name": {"type": "string"}, "ncu_timeout_s": {"type": "number", "minimum": 1}
    }},
    "kernel_fingerprint_inputs": {"type": "array", "items": {"type": "string"}}
  }
}
