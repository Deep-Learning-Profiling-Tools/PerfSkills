# Investigation state is created locally by the harness and is never source code.
runs/
workloads/
shared/tests/

# Raw profiler output that may be produced outside a run directory.
perf.data
perf.data.old
*.nsys-rep
*.qdrep
*.ncu-rep
*.sqlite
callgrind.out.*
cachegrind.out.*
massif.out.*
*.otf2
scorep-*/

__pycache__/
.ruff_cache/
*.pyc
.venv/

# Vendored upstream repos carry their own .git. Ignoring them keeps ProfileWeaver from
# swallowing them as embedded repos. If you would rather pin exact upstream commits, delete
# this line and add them as submodules instead:
#   git submodule add https://github.com/Honrrii/gvprof-agent-skill.git external/gvprof-agent-skill
# Note: this excludes external/'s *contents*, not the directory itself -- git cannot re-include
# anything beneath an excluded directory, so a bare `external/` would make the negation below
# silently do nothing.
external/*

# ...and these have NO git of their own -- gpa-agent-skill was extracted from ML-PGO (being
# deleted), drgpum-agent-skill was pruned to its core skill with its history dropped, and
# hpctoolkit-agent-skill arrived as a loose directory with no upstream at all. Each is the
# only copy: track it or lose it. See their PROVENANCE/SKILL notes.
!external/gpa-agent-skill/
!external/drgpum-agent-skill/
!external/hpctoolkit-agent-skill/
external/gpa-agent-skill/state/*
!external/gpa-agent-skill/state/.gitignore
!external/gpa-agent-skill/state/sweep-log.jsonl
